# Required: create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
CLIENT_ID=PASTE_APPLICATION_CLIENT_ID_HERE

# Optional: set this to register slash commands only in one test server (instant updates)
GUILD_ID=

# Prefix for text commands
PREFIX=.

# Anti-nuke defaults (can be configured per server)
ANTINUKE_DEFAULT_ENABLED=false
ANTINUKE_DEFAULT_THRESHOLD=3
ANTINUKE_WINDOW_SECONDS=10

# Optional owner IDs, comma-separated
OWNER_IDS=

# Optional: set DATA_DIR to a Railway Volume mount path (recommended: /data)
DATA_DIR=./data

# Music: Discord Player v6 uses extractors; some sources may change or block automated playback.
# For reliable Lavalink-based playback, configure a Lavalink server in a future adapter.
